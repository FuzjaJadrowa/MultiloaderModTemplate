{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Example Multi-Version Mod template using Fabric.",
  "authors": [
    "Example Author"
  ],
  "contact": {
    "homepage": "https://example.com",
    "sources": "https://github.com/ExampleUser/ExampleMod"
  },
  "license": "MIT",
  "icon": "assets/examplemod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.examplemod.fabric.ExampleModFabric"
    ]
  },
  "mixins": [
    "examplemod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
